sections.ReactLeft:Button({
    Name = "Moss React",
    Callback = function()
        local Players = game:GetService("Players")
        local UserInputService = game:GetService("UserInputService")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local LP = Players.LocalPlayer
        local Character = LP.Character or LP.CharacterAdded:Wait()

        local BALL = workspace:FindFirstChild("TPSSystem") and workspace.TPSSystem:FindFirstChild("TPS")
        if not BALL or not BALL:IsA("BasePart") then
            return
        end

        local MOSS_THRESHOLD = 12
        local Active = true

        local function FastMossTouch()
            if not BALL then return end
            local char = LP.Character
            if not char then return end
            if BALL.Position.Y <= MOSS_THRESHOLD then return end

            local parts = {"LeftLeg", "RightLeg", "Torso", "Head", "LeftArm", "RightArm"}
            for _, pName in ipairs(parts) do
                local p = char:FindFirstChild(pName)
                if p then
                    pcall(function()
                        for _, child in pairs(p:GetChildren()) do
                            if child:IsA("TouchInterest") then
                                child:Destroy()
                            end
                        end
                        local touch = Instance.new("TouchInterest")
                        touch.Parent = p
                        touch.Target = BALL
                        task.wait(0.01)
                        touch:Destroy()
                    end)
                end
            end

            local General = ReplicatedStorage:FindFirstChild("General")
            if General then
                local DribbleRemotes = General:FindFirstChild("Dribble") and General.Dribble:FindFirstChild("Remotes")
                if DribbleRemotes then
                    for _, remote in pairs(DribbleRemotes:GetChildren()) do
                        if remote:IsA("RemoteEvent") then
                            pcall(function()
                                remote:FireServer(BALL, 1)
                            end)
                        end
                    end
                end
            end
        end

        game:GetService("RunService").Heartbeat:Connect(function()
            if Active and BALL and BALL.Position.Y > MOSS_THRESHOLD then
                FastMossTouch()
            end
        end)

        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed or not Active then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or
               input.UserInputType == Enum.UserInputType.Keyboard then
                task.wait(0.02)
                if BALL and BALL.Position.Y > MOSS_THRESHOLD then
                    FastMossTouch()
                end
            end
        end)

        pcall(function()
            local UserSettings = UserSettings()
            local GameSettings = UserSettings:GetService("UserGameSettings")
            GameSettings:SetFFlag("FFlagDebugGraphicsDisableInterpolation", "True")
            GameSettings:SetFFlag("FFlagNetworkInterpolation", "0.01")
        end)
    end
})
